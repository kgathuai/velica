# AI image editing (optional).
#
# Everything else in the app works offline and needs no keys. Only the "AI edit"
# button in the picture editor uses these. While they are empty, that button
# replies with a message explaining what to set.

# --- Option 1: Google Gemini (simplest, has a free tier) ---
# Get a key from https://aistudio.google.com/apikey
IMAGE_EDIT_API_KEY=
IMAGE_EDIT_MODEL=gemini-2.5-flash-image

# --- Option 2: any OpenAI-compatible endpoint that can return images ---
# For example OpenRouter, which gives you one key for many models:
# IMAGE_EDIT_BASE_URL=https://openrouter.ai/api/v1
# IMAGE_EDIT_API_KEY=sk-or-...
# IMAGE_EDIT_MODEL=google/gemini-2.5-flash-image-preview

# Leave IMAGE_EDIT_BASE_URL unset to use Google Gemini directly.
# IMAGE_EDIT_BASE_URL=https://generativelanguage.googleapis.com/v1beta
