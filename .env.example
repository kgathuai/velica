# AI features (optional).
#
# Everything else in the app works offline and needs no keys. AI is used for:
#   - reading a scanned document accurately (falls back to offline matching)
#   - the "AI edit" button in the picture editor
#
# One key is enough. AI_* wins, then IMAGE_EDIT_*, then the QWEN_* vars used by
# the verification flow — so if Qwen is already configured, reading works as is.

# --- Google Gemini (simplest, has a free tier) ---
# Get a key from https://aistudio.google.com/apikey
AI_API_KEY=
AI_READ_MODEL=gemini-2.5-flash
IMAGE_EDIT_MODEL=gemini-2.5-flash-image

# --- Or any OpenAI-compatible endpoint, for example OpenRouter ---
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-...
# AI_READ_MODEL=google/gemini-2.5-flash
# IMAGE_EDIT_MODEL=google/gemini-2.5-flash-image-preview

# --- Or reuse the Qwen vision model already used for verification ---
# QWEN_BASE_URL=https://your-endpoint/v1
# QWEN_API_KEY=...
# QWEN_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# Leave AI_BASE_URL unset to talk to Google Gemini directly.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
